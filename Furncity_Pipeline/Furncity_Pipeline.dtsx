      DTS:DTSID="{41B885AB-EC4E-4A01-A475-366A1173E489}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create_Schema_Silver"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{32FD8056-BF7F-48BC-A774-4248AA34587E}"
          SQLTask:SqlStatementSource="-- Create the Silver and Gold schemas in the warehouse.&#xA;USE [Furncity_dwh];&#xA;GO&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.schemas&#xA;    WHERE name = N'Silver'&#xA;)&#xA;BEGIN&#xA;    EXEC(N'CREATE SCHEMA [Silver] AUTHORIZATION [dbo];');&#xA;END;&#xA;GO&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.schemas&#xA;    WHERE name = N'Gold'&#xA;)&#xA;BEGIN&#xA;    EXEC(N'CREATE SCHEMA [Gold] AUTHORIZATION [dbo];');&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
