      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{BA3225B0-7C0D-44F8-97E6-DC457B8395FA}"
          SQLTask:SqlStatementSource="USE master&#xA;&#xA;-- Create the data warehouse database.&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.databases&#xA;    WHERE name = N'Furncity_dwh'&#xA;)&#xA;BEGIN&#xA;    CREATE DATABASE [Furncity_dwh];&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
