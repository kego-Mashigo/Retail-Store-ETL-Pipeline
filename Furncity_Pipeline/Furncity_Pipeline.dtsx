        <SQLTask:SqlTaskData
          SQLTask:Connection="{BA3225B0-7C0D-44F8-97E6-DC457B8395FA}"
          SQLTask:SqlStatementSource="-- Create the staging database.&#xA;USE master&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.databases&#xA;    WHERE name = N'Furncity_stg'&#xA;)&#xA;&#xA;BEGIN&#xA;    CREATE DATABASE [Furncity_stg];&#xA;END;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
