    <DTS:Executable
      DTS:refId="Package\CreateTb_Rawdata"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F6FA2189-3515-4EA7-8EC9-7F03A53774EC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CreateTb_Rawdata"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F6F769E1-3196-444C-A3EF-7A8B58DB8727}"
          SQLTask:SqlStatementSource="IF OBJECT_ID(N'bronze.Rawdata', N'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE [bronze].[Rawdata]&#xA;    (&#xA;        [transaction id]   VARCHAR(50),&#xA;        [date]             VARCHAR(50),&#xA;        [customer id]      VARCHAR(50),&#xA;        [gender] VARCHAR(50),&#xA;        [age]  VARCHAR(50),&#xA;        [product category] VARCHAR(50),&#xA;        [quantity]         VARCHAR(50),&#xA;        [price per unit]   VARCHAR(50),&#xA;        [total amount]     VARCHAR(50)&#xA;    );&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CreateTb_silver_sales"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{37EF1FA2-B1B8-4AF4-A241-EBB472A3B154}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CreateTb_silver_sales"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{32FD8056-BF7F-48BC-A774-4248AA34587E}"
          SQLTask:SqlStatementSource="IF OBJECT_ID(N'silver.sales', N'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE [silver].[sales]&#xA;    (&#xA;        [transaction id]   VARCHAR(50),&#xA;        [date]             VARCHAR(50),&#xA;        [customer id]      VARCHAR(50),&#xA;        [gender] VARCHAR(50),&#xA;        [age]  VARCHAR(50),&#xA;        [product category] VARCHAR(50),&#xA;        [quantity]         VARCHAR(50),&#xA;        [price per unit]   VARCHAR(50),&#xA;        [total amount]     VARCHAR(50)&#xA;    );&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Create_Schema_Bronze"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F80A4F30-0AB1-49AC-89FD-438AF62DCCC0}"
