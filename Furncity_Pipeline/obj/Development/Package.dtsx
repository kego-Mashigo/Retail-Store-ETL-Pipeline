    <DTS:Executable
      DTS:refId="Package\CreateDb_Furncity_stg"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7511639E-0448-47E4-A1E7-DF3E4C028425}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CreateDb_Furncity_stg"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F6F769E1-3196-444C-A3EF-7A8B58DB8727}"
          SQLTask:SqlStatementSource="-- Create the staging database.&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.databases&#xA;    WHERE name = N'Furncity_stg'&#xA;)&#xA;BEGIN&#xA;    CREATE DATABASE [Furncity_stg];&#xA;END;&#xA;GO&#xA;&#xA;-- Create the data warehouse database.&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.databases&#xA;    WHERE name = N'Furncity_dwh'&#xA;)&#xA;BEGIN&#xA;    CREATE DATABASE [Furncity_dwh];&#xA;END;&#xA;GO&#xA;&#xA;-- Create the Bronze schema in staging.&#xA;USE [Furncity_stg];&#xA;GO&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.schemas&#xA;    WHERE name = N'Bronze'&#xA;)&#xA;BEGIN&#xA;    EXEC(N'CREATE SCHEMA [Bronze] AUTHORIZATION [dbo];');&#xA;END;&#xA;GO&#xA;&#xA;-- Create the Silver and Gold schemas in the warehouse.&#xA;USE [Furncity_dwh];&#xA;GO&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.schemas&#xA;    WHERE name = N'Silver'&#xA;)&#xA;BEGIN&#xA;    EXEC(N'CREATE SCHEMA [Silver] AUTHORIZATION [dbo];');&#xA;END;&#xA;GO&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.schemas&#xA;    WHERE name = N'Gold'&#xA;)&#xA;BEGIN&#xA;    EXEC(N'CREATE SCHEMA [Gold] AUTHORIZATION [dbo];');&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CreateTb_Rawdata"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F6FA2189-3515-4EA7-8EC9-7F03A53774EC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CreateTb_Rawdata"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F6F769E1-3196-444C-A3EF-7A8B58DB8727}"
          SQLTask:SqlStatementSource="IF OBJECT_ID(N'bronze.Rawdata', N'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE [bronze].[Rawdata]&#xA;    (&#xA;        [transaction id]   VARCHAR(50),&#xA;        [date]             VARCHAR(50),&#xA;        [customer id]      VARCHAR(50),&#xA;        [gender] VARCHAR(50),&#xA;        [age]  VARCHAR(50),&#xA;        [product category] VARCHAR(50),&#xA;        [quantity]         VARCHAR(50),&#xA;        [price per unit]   VARCHAR(50),&#xA;        [total amount]     VARCHAR(50)&#xA;    );&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
