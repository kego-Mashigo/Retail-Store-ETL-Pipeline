      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F6F769E1-3196-444C-A3EF-7A8B58DB8727}"
          SQLTask:SqlStatementSource="-- Create the Bronze schema in staging.&#xA;USE [Furncity_stg];&#xA;GO&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.schemas&#xA;    WHERE name = N'Bronze'&#xA;)&#xA;BEGIN&#xA;    EXEC(N'CREATE SCHEMA [Bronze] AUTHORIZATION [dbo];');&#xA;END;&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
